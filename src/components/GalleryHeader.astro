---
import HeroFrame from './HeroFrame.astro';

// Layer pieces. Positions live in the style block (design units, 791 x 383 frame).
const pic = (name: string) => ({ webp: `/images/${name}.webp`, png: `/images/${name}.png` });
const star = pic('gal-star'), sand = pic('gal-sand'), bushes = pic('gal-bushes'), helm = pic('gal-helm');
const palm = pic('gal-palm'), camera = pic('gal-camera'), camels = pic('gal-camels'), mio = pic('gal-mio');
---
<HeroFrame title="Gallery" round={112} patternOpacity={0.5}>
  <picture class="l star"><source srcset={star.webp} type="image/webp" /><img src={star.png} alt="" decoding="async" /></picture>
  <div class="sand-fill"></div>
  <picture class="l sand"><source srcset={sand.webp} type="image/webp" /><img src={sand.png} alt="" decoding="async" /></picture>
  <picture class="l bushes"><source srcset={bushes.webp} type="image/webp" /><img src={bushes.png} alt="" decoding="async" /></picture>
  <picture class="l helm"><source srcset={helm.webp} type="image/webp" /><img src={helm.png} alt="" decoding="async" /></picture>
  <picture class="l palm palm-r"><source srcset={palm.webp} type="image/webp" /><img src={palm.png} alt="" decoding="async" /></picture>

  <div class="cam">
    <picture><source srcset={camera.webp} type="image/webp" /><img class="cam-img" src={camera.png} alt="Camera - Make it your own" decoding="async" fetchpriority="high" /></picture>
    <picture class="mio"><source srcset={mio.webp} type="image/webp" /><img src={mio.png} alt="" decoding="async" /></picture>
    <picture class="flare"><source srcset={star.webp} type="image/webp" /><img src={star.png} alt="" decoding="async" /></picture>
  </div>
  <picture class="l palm palm-l"><source srcset={palm.webp} type="image/webp" /><img src={palm.png} alt="" decoding="async" /></picture>
  <picture class="l camels"><source srcset={camels.webp} type="image/webp" /><img src={camels.png} alt="" decoding="async" /></picture>
</HeroFrame>

<style>
  .l, .cam, .mio, .flare { position: absolute; display: block; }
  /* <picture> is display: contents globally; the class lands on the wrapper only for CSS vars, so style the img */
  picture.l, picture.mio, picture.flare { display: block; }
  picture img { width: 100%; height: auto; display: block; max-width: none; }

  .star { left: calc(50% + var(--hu) * 162); top: calc(var(--hu) * 40); width: calc(var(--hu) * 108); animation: twinkle 3.6s ease-in-out 1.2s infinite both; }
  .sand-fill { position: absolute; left: 0; right: 0; top: calc(var(--hu) * 268); height: calc(var(--hu) * 30); background: #f4ba17; animation: fade-up 0.9s ease 0.2s both; }
  .sand { left: 0; top: calc(var(--hu) * 236.6); width: 100%; height: calc(var(--hu) * 62); animation: fade-up 0.9s ease 0.2s both; }
  .sand img { height: 100%; }
  .bushes { right: 0; top: calc(var(--hu) * 188); width: calc(var(--hu) * 555); animation: fade-up 0.9s ease 0.35s both; }
  .helm { left: calc(50% + var(--hu) * 88); top: calc(var(--hu) * 141); width: calc(var(--hu) * 250); animation: fade-up 0.9s ease 0.45s both; }
  .helm img { animation: spin 70s linear infinite; }
  .palm { top: calc(var(--hu) * 215); width: calc(var(--hu) * 125); transform-origin: 50% 100%; }
  .palm-l { left: calc(50% - var(--hu) * 380); animation: fade-up 0.9s ease 0.3s both; }
  .palm-l img { transform-origin: 50% 100%; animation: sway 6s ease-in-out 1.2s infinite alternate; }
  .palm-r { right: calc(var(--hu) * -26); top: calc(var(--hu) * 242); transform: scaleX(-1); animation: fade-up-flip 0.9s ease 0.4s both; }
  .palm-r img { transform-origin: 50% 100%; animation: sway 7s ease-in-out 1.4s infinite alternate-reverse; }

  .cam {
    left: calc(50% - var(--hu) * 277);
    top: calc(var(--hu) * 120);
    width: calc(var(--hu) * 490);
    animation: cam-rise 1.1s cubic-bezier(0.22, 0.8, 0.25, 1) 0.1s both;
  }
  .mio { left: 10.9%; top: 35.6%; width: 15.9%; animation: fade-in 0.8s ease 1s both; }
  .flare { left: 55.2%; top: 51.1%; width: 10.3%; animation: twinkle 3s ease-in-out 1.4s infinite both; }
  .camels { left: calc(50% - var(--hu) * 52); top: calc(var(--hu) * 84); width: calc(var(--hu) * 190); animation: slide-in 1s ease 0.9s both; }

  @keyframes cam-rise { from { transform: translateY(70%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fade-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fade-up-flip { from { transform: scaleX(-1) translateY(24px); opacity: 0; } to { transform: scaleX(-1); opacity: 1; } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slide-in { from { transform: translateX(-24px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes twinkle {
    0%, 100% { transform: scale(0.9); opacity: 0.75; }
    50% { transform: scale(1.1); opacity: 1; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes sway { from { transform: rotate(-2.5deg); } to { transform: rotate(2.5deg); } }
  @media (prefers-reduced-motion: reduce) {
    .l, .cam, .mio, .flare, .helm img, .palm img { animation: none; }
  }
</style>

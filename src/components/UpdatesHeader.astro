---
import UpdateBadge from './UpdateBadge.astro';
interface Props { image?: string }
const { image } = Astro.props;
---
<header class="hdr">
  <picture><source srcset="/images/logo.webp" type="image/webp" /><img class="logo" src="/images/logo.png" alt="Darul Huda Sibaq National Arts Fest '26" decoding="async" fetchpriority="high" /></picture>

  <div class="btns">
    <button class="round" aria-label="Menu" aria-expanded="false" aria-controls="site-menu" data-menu-toggle type="button">
      <span class="dm"><i></i><i></i><i></i><i class="o"></i></span>
    </button>
    <button class="round" aria-label="Notifications" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 17V11a6 6 0 0 1 12 0v6l1.5 2h-15zM10 21h4" /></svg>
    </button>
  </div>

  <div class="stack">
    <i class="band b-red"></i>
    <i class="band b-yellow"></i>
    <div class="card">
      <div class="photo">{image && <img src={image} alt="" decoding="async" />}</div>
      <span class="badge"><UpdateBadge id="upd-hero-path" spin /></span>
      <h1 class="label">Updates</h1>
      <span class="brand"><picture><source srcset="/images/footer-brand.webp" type="image/webp" /><img src="/images/footer-brand.png" alt="Make it your own" decoding="async" fetchpriority="high" /></picture></span>
    </div>
  </div>
</header>

<style>
  .hdr {
    --h: var(--g);
    position: relative;
    height: calc(var(--h) * 300);
    margin: 0 calc(var(--h) * 25);
  }
  .logo { position: absolute; left: calc(var(--h) * 15); top: calc(var(--h) * 25); width: calc(var(--h) * 64); animation: fade-in 0.6s ease 0.1s both; }
  .btns { position: absolute; right: calc(var(--h) * 15); top: calc(var(--h) * 21); display: flex; gap: calc(var(--h) * 6); animation: fade-in 0.6s ease 0.2s both; }
  .round {
    width: calc(var(--h) * 28);
    height: calc(var(--h) * 28);
    border-radius: 50%;
    border: calc(var(--h) * 1.2) solid #f7931e;
    background: transparent;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .round:hover { transform: scale(1.08); background: rgb(247 147 30 / 0.12); }
  .round svg { width: 54%; fill: none; stroke: #f7931e; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .dm { position: relative; width: 52%; aspect-ratio: 1; transition: transform 0.4s ease, opacity 0.25s ease; }
  [aria-expanded='true'] .dm { transform: rotate(90deg) scale(0.4); opacity: 0; }
  .dm i { position: absolute; width: 24.7%; height: 24.7%; background: var(--red); transform: translate(-50%, -50%) rotate(45deg); }
  .dm i:nth-child(1) { left: 30%; top: 25%; }
  .dm i:nth-child(2) { left: 70%; top: 25%; }
  .dm i:nth-child(3) { left: 30%; top: 70%; }
  .dm i.o { left: 70%; top: 70%; background: #f7931e; }

  .stack {
    position: absolute;
    left: 50%;
    top: calc(var(--h) * 81);
    width: min(calc(var(--h) * 252), 100%);
    height: calc(var(--h) * 190);
    transform: translateX(-50%);
    animation: stack-in 0.9s cubic-bezier(0.22, 0.8, 0.25, 1) 0.15s both;
  }
  .band, .card { position: absolute; left: 0; right: 0; display: block; border-radius: calc(var(--h) * 26); }
  .b-red { top: 0; left: calc(var(--h) * 8); right: calc(var(--h) * 8); height: calc(var(--h) * 70); background: var(--red); }
  .b-yellow { top: calc(var(--h) * 14); left: calc(var(--h) * 4); right: calc(var(--h) * 4); height: calc(var(--h) * 70); background: var(--yellow); }
  .card { top: calc(var(--h) * 28); bottom: 0; background: #1d1d1d; overflow: hidden; }
  .photo { position: absolute; inset: 0 0 calc(var(--h) * 50); background: #333; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .badge { position: absolute; left: 50%; top: calc(var(--h) * 28); width: calc(var(--h) * 36); aspect-ratio: 1; display: block; transform: translateX(-50%); }
  .label { position: absolute; left: calc(var(--h) * 14); bottom: calc(var(--h) * 11); font-size: calc(var(--h) * 17); font-weight: 700; color: #fff; }
  /* crop the "make it your own" artwork out of the combined brand lock-up */
  .brand { position: absolute; right: calc(var(--h) * 12); bottom: calc(var(--h) * 6); width: calc(var(--h) * 60); aspect-ratio: 300 / 289; overflow: hidden; display: block; }
  .brand img { width: 296%; max-width: none; height: auto; animation: float 4s ease-in-out 1.2s infinite alternate; }

  /* wide screens: the same composition, scaled up to the gallery's content width */
  @media (min-width: 641px) {
    .hdr { --h: calc(var(--g) * 1.9); margin: 0 calc(var(--g) * 45); }
  }

  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes stack-in { from { transform: translate(-50%, 40px); opacity: 0; } to { transform: translateX(-50%); opacity: 1; } }
  @keyframes float { from { transform: translateY(-2%); } to { transform: translateY(2%); } }
  @media (prefers-reduced-motion: reduce) { .stack, .brand img, .logo, .btns { animation: none; } }
</style>

---
import type { UpdateNotice } from '../data/updates';
interface Props { notices: UpdateNotice[] }
const { notices } = Astro.props;
const variants = ['red', 'yellow', 'red'];
---
<section class="list" aria-label="Notices">
  <span class="bell"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 17V11a6 6 0 0 1 12 0v6l1.5 2h-15zM10 21h4" /></svg></span>
  {notices.map((n, i) => (
    <a class={`row ${variants[i % variants.length]}`} href={n.url} style={`--i:${i}`}>
      <i class="ic"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M14 6L6 14M6 7v7h7" /></svg></i>
      <span class="txt">
        <span class="title">{n.title}</span>
        <span class="when">{n.updated}</span>
      </span>
      {n.isNew && <span class="new">New</span>}
    </a>
  ))}
</section>

<style>
  .list {
    position: relative;
    margin: calc(var(--g) * 70) calc(var(--g) * 84) 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--g) * 14);
  }
  .bell { position: absolute; left: 50%; top: calc(var(--g) * -16); z-index: 1; width: calc(var(--g) * 32); height: calc(var(--g) * 32); transform: translateX(-50%); border-radius: 50%; background: #fff; border: calc(var(--g) * 1.5) solid var(--red); display: grid; place-items: center; animation: rise-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.9s both; }
  .bell svg { width: 56%; fill: none; stroke: var(--red); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(var(--g) * 16);
    padding: calc(var(--g) * 18) calc(var(--g) * 24);
    border-radius: calc(var(--g) * 28);
    animation: rise-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.9s + var(--i) * 0.12s) both;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
  }
  .red { background: #fbd5cb; }
  .yellow { background: #fbecc0; }
  .row:hover { transform: translateY(-3px); box-shadow: 0 8px 18px rgb(0 0 0 / 0.12); }
  .row:active { transform: scale(0.99); }
  .ic { flex: none; width: calc(var(--g) * 26); height: calc(var(--g) * 26); border-radius: 50%; background: var(--red); display: grid; place-items: center; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .yellow .ic { background: var(--yellow); }
  .row:hover .ic { transform: translate(2px, -2px) rotate(8deg); }
  .ic svg { width: 56%; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .txt { flex: 1; display: flex; flex-direction: column; gap: calc(var(--g) * 6); min-width: 0; }
  .title { font-size: calc(var(--g) * 19); font-weight: 700; line-height: 1.1; color: var(--ink); }
  .when { font-size: calc(var(--g) * 8); color: #999; }
  .new { align-self: flex-end; padding: calc(var(--g) * 2) calc(var(--g) * 10); border-radius: calc(var(--g) * 8); background: var(--red); color: #fff; font-size: calc(var(--g) * 8); font-weight: 700; }
  
  @media (max-width: 640px) {
    .list { margin: calc(var(--g) * 60) calc(var(--g) * 32) 0; gap: calc(var(--g) * 12); }
    .bell { width: calc(var(--g) * 24); height: calc(var(--g) * 24); top: calc(var(--g) * -12); }
    .row { padding-top: calc(var(--g) * 18); }
    .row { gap: calc(var(--g) * 10); padding: calc(var(--g) * 14) calc(var(--g) * 14); border-radius: calc(var(--g) * 22); }
    .ic { width: calc(var(--g) * 17); height: calc(var(--g) * 17); align-self: flex-start; }
    .title { font-size: calc(var(--g) * 13); }
    .when { font-size: calc(var(--g) * 7); }
    .new { font-size: calc(var(--g) * 6.5); padding: calc(var(--g) * 1.5) calc(var(--g) * 8); border-radius: calc(var(--g) * 6); }
  }
</style>
